# =============================================================================
# F1 Digital Pit Wall — environment template
# =============================================================================
# Copy this file to `.env` (same folder) and edit the values for the target
# machine.  `scripts/config.py` reads <project-root>/.env automatically at
# import time — no code or shell setup needed.  Real OS environment variables
# ALWAYS take precedence over values here (so CI/production overrides win).
#
# A `.env` file is machine-local: never commit your real one.  This template
# ships the known-good local defaults so a fresh checkout works out of the box
# when the target MySQL uses the classic root/password local-dev setup.

# ── MySQL database (used by config.py / every script) ──────────────────────
# Host of the MySQL server.  'localhost' = same machine, default port 3306.
DB_HOST=localhost
# MySQL user with rights on DB_NAME (schema lives in database/f1_strategy.sql).
DB_USER=root
# MySQL password for DB_USER.  Set to CHANGE_ME to make the app refuse to
# connect (safety check) instead of guessing.
DB_PASSWORD=password
# Database name created by database/f1_strategy.sql (or a restored dump).
DB_NAME=f1_strategy
# MySQL server port.
DB_PORT=3306

# ── Web server (read by scripts/run_server.py) ─────────────────────────────
# Port the dashboard binds.  NOTE: if the OS environment already exports
# PORT (this dev machine exports PORT=0, which makes the server bind a random
# free port), that value wins over this file — launch with PORT=5000 explicitly
# in that case.
PORT=5000
# Bind address.  0.0.0.0 serves on all interfaces; use 127.0.0.1 for local-only.
HOST=0.0.0.0

# ── Optional tunables ───────────────────────────────────────────────────────
# Minutes of recent live telemetry shown in the dashboard header (default 10).
# LIVE_WINDOW_MINUTES=10
