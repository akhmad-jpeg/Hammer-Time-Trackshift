# ── Machine-local configuration ─────────────────────────────────────────────
# .env holds this machine's DB/server credentials — never commit it.
# .env.example IS the committed template.
.env

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Database exports (large generated .sql dumps) ───────────────────────────
database/exports/

# ── Per-race energy-benchmark artifacts (regenerable, ~40MB full sweep) ─────
# The committed artifact is the small fleet summary
# (backtests/energy_fleet_summary.json); the full per-race files below are
# deterministic regenerations written by scripts/benchmark_energy_fleet.py.
backtests/energy/

# ── Local caches / runtime state ────────────────────────────────────────────
.freebuff/
f1_cache/
ml_models/
*.log
